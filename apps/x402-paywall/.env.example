# Resource server (Bun)
PORT=8787

# Vite UI (scripts/dev.ts)
X402_UI_PORT=5173

# simulated (default) — no keys, no wallet, no facilitator account
# onchain is deferred; this playground still speaks x402 v2 headers
X402_MODE=simulated

# exact-scheme quote: 10000 atomic = 0.01 USDC (6 decimals)
X402_AMOUNT=10000
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_PAY_TO=0x209693Bc6afc0C5328bA36FaF03C514EF312287C
X402_MAX_TIMEOUT_SECONDS=60

# Simulated wallet (public demo values — not a real key)
X402_SIM_FROM=0x857b06519E91e3A54538791bDbb0E22373e36b66
X402_SIM_SECRET=x402-simulated-wallet
X402_SIM_BALANCE=25000000
