# Meta Model API — leave unset to run the playground in mock mode.
# Key is read only by the Bun server; it never reaches the browser.
MODEL_API_KEY=

# OpenAI-compatible Chat Completions surface.
MODEL=muse-spark
MODEL_API_BASE=https://api.meta.ai/v1

# Local ports (Vite proxies /api → API_PORT).
API_PORT=3001
PORT=5173
