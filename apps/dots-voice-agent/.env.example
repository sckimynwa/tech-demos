# Optional. When unset, the demo runs a full simulated voice + task path
# (type-to-speak, sample chips, SpeechSynthesis barge-in, mock research/summary/file write).
# When set, Vite mints an ephemeral Realtime client secret and the call uses WebRTC.
OPENAI_API_KEY=

# Optional override (Realtime GA). Default: gpt-realtime
# OPENAI_REALTIME_MODEL=gpt-realtime

# Optional voice for Realtime output. Default: marin
# OPENAI_REALTIME_VOICE=marin
