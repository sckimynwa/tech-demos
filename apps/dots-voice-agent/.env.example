# Optional. When unset, Mock mode still works without a key.
# When set, the Realtime selector is enabled (WebRTC via ephemeral client secret).
OPENAI_API_KEY=

# Optional override (Realtime GA). Default: gpt-realtime
# OPENAI_REALTIME_MODEL=gpt-realtime

# Optional voice for Realtime output. Default: marin
# OPENAI_REALTIME_VOICE=marin

# Realtime cost guards (seconds). Auto hang-up; Mock/Local are unaffected.
# REALTIME_SILENCE_TIMEOUT_S=60
# REALTIME_MAX_SESSION_S=600

# Local mode — Qwen via Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen3:8b
# LOCAL_REFINE=1

# Local mode — Moonshine Tiny Korean sidecar
# MOONSHINE_SIDECAR_URL=http://127.0.0.1:8765
# MOONSHINE_SIDECAR_HOST=127.0.0.1
# MOONSHINE_SIDECAR_PORT=8765
# MOONSHINE_VOICE_CACHE=./sidecar/.cache
