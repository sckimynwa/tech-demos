# Unset (or empty) → mock mode: deterministic /v1/systemone sample answers.
# Examples: http://127.0.0.1:8009  or  https://<workspace>--kev-api.modal.run
KEV_BASE_URL=

# Optional. Sent only from the Bun server as Authorization: Bearer <key>.
# Never exposed to the browser (not in /api/config, not in Vite).
KEV_API_KEY=

# Default model name in requests and GET /api/config. Default: kev-latest
KEV_MODEL=kev-latest

# Bun API port. Vite proxies /api here. Default: 8787
PORT=8787
